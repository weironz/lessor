{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lessor",
  "version": "0.0.2",
  "identifier": "io.lessor.desktop",
  "build": {
    "frontendDist": "fallback"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "deb",
      "appimage",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "跨平台 DHCP 服务器",
    "longDescription": "lessor 的桌面界面。服务进程 lessord 单独运行，本程序只是它的客户端。",
    "externalBin": [
      "binaries/lessord"
    ]
  }
}
