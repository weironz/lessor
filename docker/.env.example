# 复制成 .env 再改。compose.prod.yml 会读它。
#
#   cp .env.example .env

# 管理接口的访问令牌。**必填**。
#
# 生产部署下管理接口听在 0.0.0.0:8080（host 网络），不再是只听本机 ——
# 没有令牌的话，同网段任何人都能改你的作用域、撤你的租约。
# 随便生成一个够长的：openssl rand -hex 32
LESSOR_TOKEN=

# 镜像。默认拉 Docker Hub；国内可以换成阿里云那份。
# LESSOR_IMAGE=registry.cn-shenzhen.aliyuncs.com/willspace/lessord:latest
LESSOR_IMAGE=willdockerhub/lessord:latest

# 日志级别。排查报文问题时可以 lessord::dhcp=trace（会打原始字节）。
LESSOR_LOG=info
